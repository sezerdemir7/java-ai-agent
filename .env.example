# ==========================================
# Java AI Agent - Environment Configuration
# ==========================================
# Bu dosyayı kopyalayıp '.env' olarak kaydedin ve API anahtarlarınızı girin.

# Google Gemini API Anahtarı (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Anahtarı (Groq Cloud Console: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Anahtarı (OpenAI Platform: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
